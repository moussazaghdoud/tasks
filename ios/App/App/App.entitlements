<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The person's own iCloud, where a copy of their thoughts is kept so a
	     reinstall or a new iPhone finds them. Hence's servers never see it. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.moussazaghdoud.hence</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<!-- The mailbox thoughts sent between people pass through: sealed, and
		     deleted once collected. -->
		<string>CloudKit</string>
	</array>
	<!-- ONE-OFF BUILD: point CloudKit at Development, so the inbox subscription
	     is created there once and can be deployed to Production (Production
	     refuses a subscription shape it has never seen). Remove right after. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Development</string>
	<!-- iCloud's notice that a thought has arrived. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.moussazaghdoud.hence</string>
	</array>
</dict>
</plist>
