{
  "name": "hence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hence — write first, organize later, act fast.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
