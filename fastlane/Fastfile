require 'json'

# Release automation for the iOS app.
#
# Everything runs on a macOS CI runner: no Mac, no Xcode and no manual signing
# on the developer's machine. Authentication is an App Store Connect API key;
# certificates and provisioning profiles live in a private git repository and
# are managed by `match`.

default_platform(:ios)

APP_IDENTIFIER = ENV['APP_IDENTIFIER'] || 'com.moussazaghdoud.hence'
PROJECT = 'ios/App/App.xcodeproj'
SCHEME = 'App'

def package_version
  JSON.parse(File.read(File.expand_path('../package.json', __dir__)))['version']
end

# Authenticate Spaceship (the App Store Connect client) with the API key.
# Used by the lanes that call the API directly rather than through an action.
def connect_with_api_key
  require 'spaceship'
  require 'base64'

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key: Base64.decode64(ENV.fetch('ASC_KEY_P8'))
  )
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_P8'), # base64 of the .p8 file
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  # Put the real reason on the run's Summary page, so a failure doesn't require
  # digging through hundreds of log lines.
  error do |lane, exception|
    summary = ENV['GITHUB_STEP_SUMMARY']
    next if summary.nil? || summary.empty?

    File.open(summary, 'a') do |f|
      f.puts "### fastlane failed in `#{lane}`"
      f.puts ''
      f.puts '```'
      f.puts exception.message.to_s[0, 3000]
      f.puts '```'
    end
  end

  before_all do
    # Creates a throw-away keychain on CI so imported certificates have
    # somewhere to live, and unlocks it for the build.
    setup_ci if ENV['CI']
  end

  desc 'Check the App Store Connect key works (needs only the three key secrets)'
  lane :check_auth do
    connect_with_api_key

    apps = Spaceship::ConnectAPI::App.all
    UI.success('The App Store Connect key works.')
    # The Team ID is only needed to sign a build, so don't block this check on it.
    UI.message(ENV['APPLE_TEAM_ID'] ? "Team: #{ENV['APPLE_TEAM_ID']}" : 'APPLE_TEAM_ID not set yet — needed for the build lanes, not for this check.')
    if apps.empty?
      UI.message('No apps on the account yet — run the bootstrap lane next to create one.')
    else
      apps.each { |a| UI.message("Existing app: #{a.name} (#{a.bundle_id})") }
    end
    UI.message("This app's identifier will be: #{APP_IDENTIFIER}")
  end

  desc 'Register the App ID and create the App Store Connect record (run once)'
  lane :bootstrap do
    # `produce` still authenticates with an Apple ID, not an API key, so this
    # talks to App Store Connect directly with the key — the same path
    # check_auth proved. Both steps are idempotent: re-running is harmless.
    connect_with_api_key

    app_name = ENV['APP_NAME'] || 'Hence'

    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_IDENTIFIER }
    if bundle
      UI.message("Bundle ID already registered: #{APP_IDENTIFIER}")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: app_name.gsub(/[^A-Za-z0-9 ]/, ''), # Apple rejects punctuation here
        identifier: APP_IDENTIFIER,
        platform: 'IOS'
      )
      UI.success("Registered bundle ID #{APP_IDENTIFIER}")
    end

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.message("App already in App Store Connect: #{app.name}")
    else
      Spaceship::ConnectAPI::App.create(
        name: app_name,
        version_string: package_version,
        sku: ENV['APP_SKU'] || "hence-#{Time.now.strftime('%Y%m%d%H%M')}",
        primary_locale: 'en-US',
        bundle_id: APP_IDENTIFIER,
        platforms: ['IOS'],
        company_name: ENV['COMPANY_NAME'] || app_name
      )
      UI.success("Created the App Store Connect record for '#{app_name}'")
    end

    UI.success("Ready: #{APP_IDENTIFIER}")
  end

  desc 'Compile the app without signing — proves the native project builds'
  lane :compile do
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      destination: 'generic/platform=iOS Simulator',
      xcargs: 'CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO',
      build: true
    )
  end

  desc 'Build a signed app and upload it to TestFlight'
  lane :beta do |options|
    key = asc_api_key

    # Fetches the distribution certificate and profile, creating them on the
    # first run. Stored encrypted in the private certificates repository.
    match(
      type: 'appstore',
      app_identifier: APP_IDENTIFIER,
      api_key: key,
      readonly: false,
      storage_mode: 'git',
      git_url: ENV.fetch('MATCH_GIT_URL'),
      git_basic_authorization: ENV['MATCH_GIT_BASIC_AUTHORIZATION']
    )

    # match publishes the profile it installed two ways; take whichever is set.
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    profile_name = mapping[APP_IDENTIFIER] || ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    UI.user_error!('match did not return a provisioning profile name') if profile_name.to_s.empty?
    UI.message("Signing with profile: #{profile_name}")

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      targets: [SCHEME],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name
    )

    # Version comes from package.json; build number from the CI run, so every
    # upload is unique and traceable back to a commit.
    version = ENV['MARKETING_VERSION'] || package_version
    build_number = ENV['BUILD_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'Hence.ipa',
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      changelog: options[:changelog] || ENV['CHANGELOG'] || "Build #{build_number} from #{ENV['GITHUB_SHA'] || 'local'}",
      distribute_external: false
    )

    UI.success("Uploaded #{version} (#{build_number}) to TestFlight.")
  end

  desc 'Submit the build currently in TestFlight for App Store review'
  lane :release do |options|
    key = asc_api_key
    deliver(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      force: true, # no HTML preview on CI
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: options[:skip_metadata] != false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
