require 'json'

# Release automation for the iOS app.
#
# Everything runs on a macOS CI runner: no Mac, no Xcode and no manual signing
# on the developer's machine. Authentication is an App Store Connect API key;
# certificates and provisioning profiles live in a private git repository and
# are managed by `match`.

default_platform(:ios)

APP_IDENTIFIER = ENV['APP_IDENTIFIER'] || 'com.moussazaghdoud.hence'
PROJECT = 'ios/App/App.xcodeproj'
SCHEME = 'App'

def package_version
  JSON.parse(File.read(File.expand_path('../package.json', __dir__)))['version']
end

# An unset workflow input arrives as an empty string, not as nil — treat both
# as "not provided", or an empty version reaches the build settings and Apple
# rejects the upload for a missing CFBundleShortVersionString.
def env_or(name, fallback)
  value = ENV[name].to_s.strip
  value.empty? ? fallback : value
end

# Write a note on the GitHub run's Summary page, when running in CI.
def write_summary(markdown)
  path = ENV['GITHUB_STEP_SUMMARY']
  return if path.nil? || path.empty?

  File.open(path, 'a') { |f| f.puts(markdown) }
end

# Authenticate Spaceship (the App Store Connect client) with the API key.
# Used by the lanes that call the API directly rather than through an action.
def connect_with_api_key
  require 'spaceship'
  require 'base64'

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key: Base64.decode64(ENV.fetch('ASC_KEY_P8'))
  )
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_P8'), # base64 of the .p8 file
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  # Put the real reason on the run's Summary page, so a failure doesn't require
  # digging through hundreds of log lines.
  error do |lane, exception|
    summary = ENV['GITHUB_STEP_SUMMARY']
    next if summary.nil? || summary.empty?

    File.open(summary, 'a') do |f|
      f.puts "### fastlane failed in `#{lane}`"
      f.puts ''
      f.puts '```'
      f.puts exception.message.to_s[0, 3000]
      f.puts '```'
    end
  end

  before_all do
    # Creates a throw-away keychain on CI so imported certificates have
    # somewhere to live, and unlocks it for the build.
    setup_ci if ENV['CI']
  end

  desc 'Check the App Store Connect key works (needs only the three key secrets)'
  lane :check_auth do
    connect_with_api_key

    apps = Spaceship::ConnectAPI::App.all
    UI.success('The App Store Connect key works.')
    # The Team ID is only needed to sign a build, so don't block this check on it.
    UI.message(ENV['APPLE_TEAM_ID'] ? "Team: #{ENV['APPLE_TEAM_ID']}" : 'APPLE_TEAM_ID not set yet — needed for the build lanes, not for this check.')
    if apps.empty?
      UI.message('No apps on the account yet — run the bootstrap lane next to create one.')
    else
      apps.each { |a| UI.message("Existing app: #{a.name} (#{a.bundle_id})") }
    end
    UI.message("This app's identifier will be: #{APP_IDENTIFIER}")
  end

  desc 'Register the App ID and create the App Store Connect record (run once)'
  lane :bootstrap do
    # `produce` still authenticates with an Apple ID, not an API key, so this
    # talks to App Store Connect directly with the key — the same path
    # check_auth proved. Both steps are idempotent: re-running is harmless.
    connect_with_api_key

    app_name = env_or('APP_NAME', 'Hence')

    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_IDENTIFIER }
    if bundle
      UI.message("Bundle ID already registered: #{APP_IDENTIFIER}")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: app_name.gsub(/[^A-Za-z0-9 ]/, ''), # Apple rejects punctuation here
        identifier: APP_IDENTIFIER,
        platform: 'IOS'
      )
      UI.success("Registered bundle ID #{APP_IDENTIFIER}")
    end

    # The App Store Connect API cannot create apps — `POST /v1/apps` does not
    # exist in the public API, for any key or role. The app record is made once
    # in the browser; everything after that is automated.
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.success("App Store Connect record found: #{app.name} (#{app.bundle_id})")
      UI.success('Nothing left to do — run the beta lane next.')
    else
      steps = <<~STEPS
        The bundle ID is registered, but the app record does not exist yet.
        Apple does not allow creating it through the API, so do this once:

          1. https://appstoreconnect.apple.com/apps  →  "+"  →  New App
          2. Platform: iOS
          3. Name: #{app_name}          (must be unique across the App Store)
          4. Primary Language: English (U.S.)
          5. Bundle ID: #{APP_IDENTIFIER}   (pick it from the list)
          6. SKU: #{ENV['APP_SKU'] || 'hence-001'}   (any unique string, never shown to users)
          7. User Access: Full Access  →  Create

        Then run this lane again to confirm, or go straight to the beta lane.
      STEPS
      UI.important(steps)
      write_summary("### One manual step\n\n```\n#{steps}```")
      UI.user_error!('App Store Connect record missing — see the instructions above.')
    end
  end

  desc 'Compile the app without signing — proves the native project builds'
  lane :compile do
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      destination: 'generic/platform=iOS Simulator',
      xcargs: 'CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO',
      build: true
    )
  end

  desc 'Build a signed app and upload it to TestFlight'
  lane :beta do |options|
    key = asc_api_key

    # Fail in seconds rather than after a 15-minute build and archive.
    connect_with_api_key
    unless Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
        UI.user_error!("No App Store Connect record for #{APP_IDENTIFIER}. Create it once at " \
                       'https://appstoreconnect.apple.com/apps (+ → New App), then run this again. ' \
                       'Apple does not allow creating it through the API.')
    end

    # Fetches the distribution certificate and profile, creating them on the
    # first run. Stored encrypted in the private certificates repository.
    match(
      type: 'appstore',
      app_identifier: APP_IDENTIFIER,
      api_key: key,
      readonly: false,
      storage_mode: 'git',
      git_url: ENV.fetch('MATCH_GIT_URL'),
      git_basic_authorization: ENV['MATCH_GIT_BASIC_AUTHORIZATION']
    )

    # match publishes the profile it installed two ways; take whichever is set.
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    profile_name = mapping[APP_IDENTIFIER] || ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    UI.user_error!('match did not return a provisioning profile name') if profile_name.to_s.empty?
    UI.message("Signing with profile: #{profile_name}")

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      targets: [SCHEME],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name
    )

    # Version comes from package.json; build number from the CI run, so every
    # upload is unique and traceable back to a commit.
    version = env_or('MARKETING_VERSION', package_version)
    build_number = env_or('BUILD_NUMBER', Time.now.strftime('%Y%m%d%H%M'))
    UI.user_error!('No marketing version: set one in package.json or in the workflow input.') if version.empty?
    UI.message("Building #{version} (#{build_number})")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'Hence.ipa',
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    # Release notes can only be attached once App Store Connect lists the build,
    # so passing them makes fastlane poll until it does — which at night took
    # over twenty minutes after the upload had already finished. Only wait when
    # someone actually wrote notes; the build number says the rest.
    notes = (options[:changelog] || env_or('CHANGELOG', '')).to_s.strip

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      changelog: notes.empty? ? nil : notes,
      distribute_external: false
    )

    UI.success("Uploaded #{version} (#{build_number}) to TestFlight.")
  end

  desc 'Submit the build currently in TestFlight for App Store review'
  lane :release do |options|
    key = asc_api_key
    deliver(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      force: true, # no HTML preview on CI
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: options[:skip_metadata] != false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
